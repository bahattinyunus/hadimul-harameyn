{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Campaign",
  "description": "Yavuz Sultan Selim dönemi askeri sefer ve meydan muharebeleri veri şeması",
  "type": "object",
  "required": [
    "campaign_id",
    "title",
    "date",
    "region",
    "coordinates",
    "commanders",
    "tactical_breakdown",
    "historical_significance",
    "primary_source_references"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^CMP-[0-9]{4}-[A-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "campaign_duration": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "region": {
      "type": "string"
    },
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "belligerents": {
      "type": "object",
      "properties": {
        "ottoman": { "type": "string" },
        "opponent": { "type": "string" }
      }
    },
    "commanders": {
      "type": "object",
      "required": ["ottoman"],
      "properties": {
        "ottoman": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "casualty_status": { "type": "string" }
            }
          }
        },
        "opponent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "casualty_status": { "type": "string" }
            }
          }
        },
        "safavid": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "casualty_status": { "type": "string" }
            }
          }
        },
        "mamluk": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "casualty_status": { "type": "string" }
            }
          }
        }
      }
    },
    "forces_estimate": {
      "type": "object",
      "properties": {
        "ottoman": {
          "type": "object",
          "properties": {
            "total_estimate": { "type": "string" },
            "janissaries_infantry": { "type": "string" },
            "cavalry_sipahi": { "type": "string" },
            "artillery_pieces": { "type": "string" }
          }
        },
        "opponent": {
          "type": "object",
          "properties": {
            "total_estimate": { "type": "string" },
            "cavalry": { "type": "string" },
            "infantry": { "type": "string" },
            "artillery_pieces": { "type": "string" }
          }
        }
      }
    },
    "tactical_breakdown": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "battle_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "title", "description"],
        "properties": {
          "phase": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "historical_significance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "primary_source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_work", "author"],
        "properties": {
          "source_work": { "type": "string" },
          "author": { "type": "string" },
          "citation": { "type": "string" },
          "excerpt": { "type": "string" }
        }
      }
    }
  }
}
