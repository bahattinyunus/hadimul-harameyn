{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimelineCollection",
  "description": "Yavuz Sultan Selim dönemi kronolojik hadiseler şeması",
  "type": "object",
  "required": ["version", "events"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "event_type", "title", "description", "location"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVT-[0-9]{4}-[0-9]{3}$" },
          "date": { "type": "string", "format": "date" },
          "hijri_date": { "type": "string" },
          "event_type": {
            "type": "string",
            "enum": ["military", "diplomatic", "administrative", "religious_symbolic", "cultural"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "key_figures": {
            "type": "array",
            "items": { "type": "string" }
          },
          "primary_sources": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
