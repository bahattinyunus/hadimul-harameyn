{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteNodeCollection",
  "description": "Yavuz Sultan Selim dönemi menzil güzergâhı ve konaklama noktaları GeoJSON şeması",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["FeatureCollection"]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Feature"]
          },
          "properties": {
            "type": "object",
            "required": ["node_id", "name", "step_order"],
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^MNZ-[0-9]{3}$"
              },
              "step_order": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 2
              },
              "historical_name": {
                "type": "string"
              },
              "campaign_id": {
                "type": "string"
              },
              "date_reached": {
                "type": "string"
              },
              "date_departed": {
                "type": "string"
              },
              "stay_duration_days": {
                "type": "number",
                "minimum": 0
              },
              "elevation_meters": {
                "type": "number"
              },
              "terrain_type": {
                "type": "string"
              },
              "water_supply_status": {
                "type": "string"
              },
              "logistics_note": {
                "type": "string"
              },
              "historical_event": {
                "type": "string"
              },
              "primary_source_ref": {
                "type": "string"
              }
            }
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Point"]
              },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
